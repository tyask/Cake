DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# DB計測ログ: all（全件）/ slow（遅い成功と失敗全件）/ off（失敗も含め無効）
# 未設定はPreview・ローカル開発でall、それ以外でslow。本番はslowが既定です。
# 調査時だけ既定値を上書きします。
# DB_QUERY_LOG=all
# 遅いクエリの閾値（ミリ秒）。既定500、0も指定できます。
# DB_SLOW_QUERY_MS=500
AUTH_SECRET=openssl-rand-base64-32
AUTH_GOOGLE_ID=google-oauth-client-id
AUTH_GOOGLE_SECRET=google-oauth-client-secret
AUTH_URL=http://localhost:3000
# 通常はGoogleログインを使用。利用者・管理者の権限はDBで管理します。
AUTH_MODE=google
# 定期支払いのCron用。Productionでは16文字以上のランダムな値をVercelで設定します。
# CRON_SECRET=
# ローカル/Preview専用DBでA・Bのテストログインを使う場合だけtestに変更
# PreviewではCAKE_TEST_DATABASE_URLがVercelのNeon連携からブランチごとに渡されます。
# ここへ本番DBの接続情報をコピーしないでください。
# worktree作成先を変更する場合だけ設定します（既定は元repoの兄弟Cake-worktrees）。
# CAKE_WORKTREE_ROOT=/path/to/Cake-worktrees
