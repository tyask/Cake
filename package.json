{
  "name": "cake-next-sample",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "node --import tsx scripts/build/vercel-build.ts",
    "start": "next start",
    "lint": "eslint .",
    "check:node": "node scripts/tooling/check-node-version.mjs",
    "db:setup": "node scripts/db/setup-db.mjs",
    "db:seed:test": "tsx scripts/db/seed-test-users.ts",
    "task:start": "node scripts/tooling/check-node-version.mjs && node --import tsx scripts/task/start-task.ts",
    "deploy:preview": "node --import tsx scripts/preview/preview-command.ts deploy",
    "task:pr": "node --import tsx scripts/task/task-pr.ts",
    "test": "node --no-wasm-code-gc --import tsx --test --test-concurrency=2 \"tests/**/*.test.ts\"",
    "qa:status": "node --import tsx scripts/preview/preview-command.ts status",
    "qa:verify": "node --import tsx scripts/preview/preview-command.ts verify",
    "qa:windows": "node --import tsx scripts/qa/windows/windows-qa.ts",
    "qa:verify:ci": "node --import tsx scripts/preview/preview-verify-command.ts",
    "qa:release": "node --import tsx scripts/preview/preview-command.ts cleanup",
    "typecheck": "tsc --noEmit",
    "check:docs": "node --import tsx scripts/tooling/check-docs.ts",
    "test:architecture": "node --no-wasm-code-gc --import tsx --test --test-concurrency=2 \"tests/architecture/**/*.test.ts\"",
    "test:shared": "node --no-wasm-code-gc --import tsx --test --test-concurrency=2 \"tests/shared/**/*.test.ts\"",
    "test:client": "node --no-wasm-code-gc --import tsx --test --test-concurrency=2 \"tests/client/**/*.test.ts\"",
    "test:server": "node --no-wasm-code-gc --import tsx --test --test-concurrency=2 \"tests/server/**/*.test.ts\"",
    "test:tooling": "node --no-wasm-code-gc --import tsx --test --test-concurrency=2 \"tests/tooling/**/*.test.ts\"",
    "check:fast": "npm run check:node && npm run lint && npm run typecheck && npm run test:architecture && npm run check:docs",
    "setup:cloud": "node scripts/cloud/setup-cloud.mjs",
    "dev:cloud": "node --no-wasm-code-gc --import tsx scripts/cloud/dev-cloud.ts",
    "qa:cloud": "node --no-wasm-code-gc --import tsx scripts/cloud/verify-cloud.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "next": "latest",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.5.4",
    "qrcode.react": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "latest",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "0.28.1",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "pg": "8.23.1",
    "playwright": "1.62.1",
    "tsx": "^4.23.1",
    "typescript": "latest"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
