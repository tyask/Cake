{
  "name": "cake-next-sample",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "node --import tsx scripts/build/vercel-build.ts",
    "start": "next start",
    "lint": "eslint .",
    "db:setup": "node scripts/db/setup-db.mjs",
    "db:seed:test": "tsx scripts/db/seed-test-users.ts",
    "task:start": "node --import tsx scripts/task/start-task.ts",
    "deploy:preview": "node --import tsx scripts/preview/preview-command.ts deploy",
    "task:pr": "node --import tsx scripts/task/task-pr.ts",
    "test": "node --import tsx --test --test-concurrency=2 \"tests/**/*.test.ts\"",
    "qa:status": "node --import tsx scripts/preview/preview-command.ts status",
    "qa:verify": "node --import tsx scripts/preview/preview-command.ts verify",
    "qa:windows": "node --import tsx scripts/qa/windows/windows-qa.ts",
    "qa:verify:ci": "node --import tsx scripts/preview/preview-verify-command.ts",
    "qa:release": "node --import tsx scripts/preview/preview-command.ts cleanup"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "next": "latest",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.5.4",
    "qrcode.react": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "latest",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "esbuild": "0.28.1",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "pg": "8.23.1",
    "playwright": "1.62.1",
    "tsx": "^4.23.1",
    "typescript": "latest"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
